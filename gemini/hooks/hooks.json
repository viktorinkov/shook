{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "ste-session-start",
            "type": "command",
            "command": "bash \"${extensionPath}/../hooks/session-start.sh\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "ste-prompt",
            "type": "command",
            "command": "bash \"${extensionPath}/../hooks/user-prompt-submit.sh\"",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "ste-lint-gate",
            "type": "command",
            "command": "bash \"${extensionPath}/../hooks/stop-gate.sh\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
